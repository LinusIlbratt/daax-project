# Supabase (för Vercel / production – krävs för API och SSR)
# Hämta från Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Publik URL (samma projekt som ovan) – används av next/image för produktbilder från Storage
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co

# Lokal utveckling: lämna tomt för att använda data/products.json istället

# Resend (transaktionella bokningsmejl)
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL="Forshälla Alltjänst <bokning@din-verifierade-domän.se>"

# Stripe (Auth & Capture – manual capture vid kassa)
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxx
# Webhook: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# Cron (Vercel sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=your-random-secret
# Hours before unpaid pending bookings are auto-canceled (default 24)
PENDING_BOOKING_EXPIRY_HOURS=24
